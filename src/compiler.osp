// compiler.osp - Compilador automatico de main.block a coordenadas 3D en Oriented-Direct

val fs = process.getBuiltinModule("fs");
val path = process.getBuiltinModule("path");

import { Vec3, Block } from "./types.osp";
import { World3D, Symmetry } from "./world.osp";
import { Exporter } from "./exporter.osp";

export fn compileMainBlock(filePath = null) {
  mut targetPath = filePath;
  unless (targetPath and fs.existsSync(targetPath)) {
    val localPath = path.resolve("main.block");
    val rootPath = path.resolve("../main.block");
    val hasLocal = fs.existsSync(localPath);
    val hasRoot = fs.existsSync(rootPath);
    if (hasLocal and hasRoot) {
      val localM = fs.statSync(localPath).mtimeMs;
      val rootM = fs.statSync(rootPath).mtimeMs;
      targetPath = (rootM > localM) ? rootPath : localPath;
    } else if (hasLocal) {
      targetPath = localPath;
    } else if (hasRoot) {
      targetPath = rootPath;
    }
  }

  unless (targetPath and fs.existsSync(targetPath)) {
    @error("[Compiler] main.block no existe en la raiz del proyecto.");
    return null;
  }

  @log(`\n=================================================`);
  @log(` [Compiler] Compilando ${path.basename(targetPath)}...`);
  @log(`=================================================`);

  val code = fs.readFileSync(targetPath, "utf-8");
  val world = new World3D();

  // Entorno de ejecucion con inyeccion de dependencias
  val context = {
    "world": world,
    "Vec3": (x, y, z) => new Vec3(x, y, z),
    "Block": (id, states) => new Block(id, states),
    "Symmetry": Symmetry,
    "console": console,
    "Math": Math,
    "set": (x, y, z, id, states = {}) => world.setBlock(new Vec3(x, y, z), new Block(id, states)),
    "fillBox": (x1, y1, z1, x2, y2, z2, id, states = {}) => {
      val minX = Math.min(x1, x2); val maxX = Math.max(x1, x2);
      val minY = Math.min(y1, y2); val maxY = Math.max(y1, y2);
      val minZ = Math.min(z1, z2); val maxZ = Math.max(z1, z2);
      for (mut y = minY; y <= maxY; y += 1) {
        for (mut z = minZ; z <= maxZ; z += 1) {
          for (mut x = minX; x <= maxX; x += 1) {
            world.setBlock(new Vec3(x, y, z), new Block(id, states));
          }
        }
      }
    }
  };

  val runner = new Function("ctx", `
    with (ctx) {
      ${code}
    }
  `);
  runner(context);

  val exporter = new Exporter("./output");
  val exportResults = exporter.exportAll(world, "test_structure");
  val serialized = world.serialize();

  // Guardar en public/coordinates.json para el visor 3D
  val publicDir = path.resolve("public");
  if (fs.existsSync(publicDir)) {
    fs.writeFileSync(path.join(publicDir, "coordinates.json"), JSON.stringify(serialized), "utf-8");
    fs.writeFileSync(path.join(publicDir, "main.block"), code, "utf-8");
  }

  // Guardar en la raiz devbuild/coordinates.json
  fs.writeFileSync(path.resolve("coordinates.json"), JSON.stringify(serialized), "utf-8");

  @log(`[Compiler] Exito: ${exportResults.totalBlocks} bloques compilados.`);
  @log(`[Compiler] Dimensiones: ${serialized.bounds.dimensions.x} x ${serialized.bounds.dimensions.y} x ${serialized.bounds.dimensions.z}`);
  @log(`[Compiler] Coordenadas sincronizadas en public/coordinates.json`);

  // Compilar automaticamente el frontend con ospc build
  val cp = process.getBuiltinModule("child_process");
  try {
    cp.execSync("ospc build --public --sourcemap", { "stdio": "inherit" });
  } catch (err) {
    // Si ospc ya esta ocupado o en dev server
  }

  return serialized;
}

compileMainBlock();

val isWatch = process.argv.includes("--watch");
if (isWatch) {
  val chokidar = require("chokidar");
  @log("\n[Compiler] Observando main.block... Al reemplazarlo se recompila al instante.");
  chokidar.watch(["main.block", "../main.block"], {
    "ignoreInitial": true,
    "awaitWriteFinish": { "stabilityThreshold": 150, "pollInterval": 50 }
  }).on("change", (filePath) => compileMainBlock(filePath)).on("add", (filePath) => compileMainBlock(filePath));
}
