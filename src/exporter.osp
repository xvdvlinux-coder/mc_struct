// exporter.osp - Exportador de archivos .mcstructure binarios, coordinates.json y build.log para Minecraft Bedrock en Oriented-Direct

val fs = process.getBuiltinModule("fs");
val path = process.getBuiltinModule("path");

import { serializeMcStructure } from "./mcstructure.osp";

class Exporter {
  constructor(outputDir = "./output") {
    this.outputDir = path.resolve(outputDir);
    unless (fs.existsSync(this.outputDir)) {
      fs.mkdirSync(this.outputDir, { "recursive": true });
    }
  }

  exportAll(world, filenamePrefix = "test_structure") {
    val serialized = world.serialize();
    val bounds = serialized.bounds;

    // 1. Exportar coordinates.json para el visor Three.js
    val coordsPath = path.join(this.outputDir, "coordinates.json");
    fs.writeFileSync(coordsPath, JSON.stringify(serialized, null, 2), "utf-8");

    // 2. Exportar build.log con auditoria de volumen y bloques
    val logContent = this._generateLog(serialized);
    val logPath = path.join(this.outputDir, "build.log");
    fs.writeFileSync(logPath, logContent, "utf-8");

    // 3. Exportar archivo binario nativo .mcstructure para Structure Block de Bedrock
    val structureBuffer = serializeMcStructure(world);
    val structurePath = path.join(this.outputDir, `${filenamePrefix}.mcstructure`);
    fs.writeFileSync(structurePath, structureBuffer);

    return {
      "coordsPath": coordsPath,
      "logPath": logPath,
      "structurePath": structurePath,
      "totalBlocks": bounds.total
    };
  }

  _generateLog(serialized) {
    val bounds = serialized.bounds;
    val blocks = serialized.blocks;
    val blockCounts = {};
    val layerCounts = {};

    val totalBlocks = blocks.length;
    for (mut i = 0; i < totalBlocks; i += 1) {
      val b = blocks[i];
      blockCounts[b.name] = (blockCounts[b.name] or 0) + 1;
      layerCounts[b.y] = (layerCounts[b.y] or 0) + 1;
    }

    val lines = [
      "====================================================",
      "     AUDITORIA DE ESTRUCTURA (.mcstructure) BEDROCK",
      "====================================================",
      `Fecha: ${new Date().toLocaleString()}`,
      `Total de Bloques: ${bounds.total}`,
      `Dimensiones (X x Y x Z): ${bounds.dimensions.x} x ${bounds.dimensions.y} x ${bounds.dimensions.z}`,
      `Limites: [${bounds.min.x}, ${bounds.min.y}, ${bounds.min.z}] hasta [${bounds.max.x}, ${bounds.max.y}, ${bounds.max.z}]`,
      `Formato: Bedrock .mcstructure (Little-Endian NBT)`,
      "",
      "--- DESGLOSE POR TIPO DE BLOQUE ---"
    ];

    val entries = Object.entries(blockCounts).sort((a, b) => b[1] - a[1]);
    val totalEntries = entries.length;
    for (mut i = 0; i < totalEntries; i += 1) {
      val entry = entries[i];
      val name = entry[0];
      val count = entry[1];
      lines.push(`  • ${name.padEnd(28, " ")} : ${count} bloques`);
    }

    lines.push("", "--- DESGLOSE POR CAPAS (ALTURA Y) ---");
    val sortedLayers = Object.keys(layerCounts).map(Number).sort((a, b) => a - b);
    val totalLayers = sortedLayers.length;
    for (mut i = 0; i < totalLayers; i += 1) {
      val y = sortedLayers[i];
      lines.push(`  Capa Y = ${String(y).padStart(3, " ")} : ${layerCounts[y]} bloques`);
    }

    lines.push("====================================================");
    return lines.join("\n");
  }
}

export { Exporter };
